rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /heroPhotos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /videoCategories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /management/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /homeSections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /whyPillars/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /programCards/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /campusSpots/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /faqItems/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
