rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /management/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /homeSections/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
